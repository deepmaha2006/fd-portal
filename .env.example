# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fdportal?retryWrites=true&w=majority"

# ─── Next Auth ────────────────────────────────────────────────────────────────
# Run: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="https://your-domain.com"

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
APP_ENV="production"   # development | test | production

# ─── Email (Nodemailer / SMTP) ────────────────────────────────────────────────
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"       # true for port 465
SMTP_USER="no-reply@your-domain.com"
SMTP_PASSWORD="SMTP_PASSWORD_HERE"
EMAIL_FROM="FD Portal <no-reply@your-domain.com>"

# ─── File Storage ─────────────────────────────────────────────────────────────
# Local storage path (relative to project root) or absolute path
UPLOAD_DIR="./uploads"
UPLOAD_MAX_SIZE_MB="20"
# For S3-compatible storage (optional — leave empty for local storage):
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SIGNED_URL_EXPIRY_SECONDS="300"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max login attempts per 15-minute window per IP
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_LOGIN_WINDOW_SECONDS="900"

# ─── MFA (TOTP) ───────────────────────────────────────────────────────────────
MFA_ISSUER="FD Portal"
# Encryption key for TOTP secrets (32-byte hex): openssl rand -hex 32
MFA_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_HEX"

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="info"   # debug | info | warn | error

# ─── Scheduled Jobs ───────────────────────────────────────────────────────────
# Cron schedule for reminder processing (default: 6 AM UTC daily)
REMINDER_CRON="0 6 * * *"

# ─── CORS (comma-separated) ───────────────────────────────────────────────────
ALLOWED_ORIGINS="https://your-domain.com"

# ─── Admin Seed ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@your-domain.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SEED_ADMIN_NAME="System Administrator"
