// Prisma schema for FD/Security Deposit Management Portal
// Database: MongoDB Atlas
// After schema changes run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  FINANCE_OFFICER
  AUDITOR
  VIEWER
  CLIENT
}

enum PaymentRequestType {
  NEW_DEPOSIT
  RENEWAL
  RELEASE
  PAYMENT_QUERY
  OTHER
}

enum PaymentRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

enum DepositType {
  FIXED_DEPOSIT
  SECURITY_DEPOSIT
  BANK_GUARANTEE
  EARNEST_MONEY
  LEASE_DEPOSIT
  OTHER
}

enum DepositStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  MATURING_SOON
  MATURED
  RENEWAL_PENDING
  RENEWED
  RELEASE_PENDING
  RELEASED
  CANCELLED
  ARCHIVED
}

enum DocumentType {
  FDR_CERTIFICATE
  RECEIPT
  BANK_CORRESPONDENCE
  CONTRACT
  RENEWAL_DOCUMENT
  RELEASE_DOCUMENT
  SUPPORTING_EVIDENCE
  OTHER
}

enum NotificationEvent {
  DAYS_90
  DAYS_60
  DAYS_30
  DAYS_15
  DAYS_7
  DAYS_1
  ON_DATE
  OVERDUE
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum KycDocumentType {
  AADHAAR
  PAN_CARD
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  BANK_STATEMENT
  UTILITY_BILL
  OTHER
}

enum KycStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AuditAction {
  // Auth
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  MFA_ENABLED
  MFA_DISABLED
  SESSION_REVOKED
  // User management
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_ACTIVATED
  USER_ROLE_CHANGED
  // Deposit
  DEPOSIT_CREATED
  DEPOSIT_UPDATED
  DEPOSIT_STATUS_CHANGED
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  DEPOSIT_SUBMITTED
  DEPOSIT_RELEASED
  DEPOSIT_RENEWED
  DEPOSIT_CANCELLED
  DEPOSIT_ARCHIVED
  DEPOSIT_VIEWED
  DEPOSIT_EXPORTED
  // Documents
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  DOCUMENT_REPLACED
  DOCUMENT_DELETED
  // Notifications
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  REMINDER_CONFIG_CHANGED
  // KYC
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  // Admin
  SETTINGS_CHANGED
  REPORT_GENERATED
  EXPORT_GENERATED
  WEBHOOK_RECEIVED
  // Security
  PERMISSION_DENIED
  DEPOSIT_DELETE_REQUESTED
  DEPOSIT_DELETE_APPROVED
  MFA_CHALLENGE_PASSED
  MFA_CHALLENGE_FAILED
  TOKEN_REVOKED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id                   String     @id @default(cuid()) @map("_id")
  email                String     @unique
  emailVerified        DateTime?
  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?
  name                 String
  hashedPassword       String?
  role                 UserRole   @default(FINANCE_OFFICER)
  status               UserStatus @default(ACTIVE)
  department           String?
  mfaEnabled           Boolean    @default(false)
  mfaSecret            String?
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  createdById          String?

  sessions             Session[]
  accounts             Account[]
  depositsCreated      Deposit[]         @relation("DepositCreatedBy")
  depositsOwned        Deposit[]         @relation("DepositOwner")
  depositsApproved     Deposit[]         @relation("DepositApprovedBy")
  approvalActions      ApprovalRequest[] @relation("ApprovalActor")
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  notificationPrefs    NotificationPreference[]
  paymentRequests      PaymentRequest[]  @relation("ClientRequests")
  reviewedRequests     PaymentRequest[]  @relation("ReviewedRequests")
  isKycVerified        Boolean           @default(false)
  kycVerification      KycVerification?
  kycReviewed          KycVerification[] @relation("KycReviewer")
  // JWT revocation: bump this field on role change, deactivation, or password reset
  tokenVersion         Int               @default(0)

  @@index([status])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Reference Data ───────────────────────────────────────────────────────────

model Bank {
  id        String       @id @default(cuid()) @map("_id")
  name      String       @unique
  code      String?      @unique
  branches  BankBranch[]
  deposits  Deposit[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model BankBranch {
  id        String    @id @default(cuid()) @map("_id")
  bankId    String
  name      String
  ifsc      String?
  address   String?
  city      String?
  bank      Bank      @relation(fields: [bankId], references: [id])
  deposits  Deposit[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([bankId, name])
  @@index([bankId])
}

model Beneficiary {
  id        String    @id @default(cuid()) @map("_id")
  name      String
  type      String?
  panNumber String?
  gstNumber String?
  address   String?
  contact   String?
  email     String?
  deposits  Deposit[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Department {
  id        String    @id @default(cuid()) @map("_id")
  name      String    @unique
  code      String?   @unique
  deposits  Deposit[]
  createdAt DateTime  @default(now())
}

// ─── Core Deposit Model ───────────────────────────────────────────────────────

model Deposit {
  id                  String        @id @default(cuid()) @map("_id")
  referenceNumber     String        @unique
  certificateNumber   String?
  depositType         DepositType   @default(FIXED_DEPOSIT)
  status              DepositStatus @default(DRAFT)

  bankId              String?
  branchId            String?
  accountNumber       String?
  bank                Bank?         @relation(fields: [bankId], references: [id])
  branch              BankBranch?   @relation(fields: [branchId], references: [id])

  beneficiaryId       String?
  beneficiary         Beneficiary?  @relation(fields: [beneficiaryId], references: [id])
  issuingOrganization String?
  vendorReference     String?
  contractNumber      String?

  // Float replaces Decimal (MongoDB Atlas does not support Prisma Decimal type)
  principalAmount     Float
  currency            String        @default("INR")
  interestRate        Float?
  maturityAmount      Float?

  issueDate           DateTime
  maturityDate        DateTime?
  expiryDate          DateTime?
  renewalDate         DateTime?
  releaseDate         DateTime?

  departmentId        String?
  department          Department?   @relation(fields: [departmentId], references: [id])
  ownerId             String?
  owner               User?         @relation("DepositOwner", fields: [ownerId], references: [id])

  approvedById        String?
  approvedAt          DateTime?
  approvedBy          User?         @relation("DepositApprovedBy", fields: [approvedById], references: [id])

  isRenewalEligible   Boolean       @default(true)
  renewedFromId       String?
  renewedToId         String?
  notes               String?
  tags                String[]      @default([])

  createdById         String?
  createdBy           User?         @relation("DepositCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Maker-checker: who requested the release (cannot also approve it)
  releaseRequestedById String?

  // Soft delete: no hard deletes; requires reason + dual approval
  deletedAt           DateTime?
  deletedById         String?
  deleteReason        String?

  documents           Document[]
  lifecycleEvents     LifecycleEvent[]
  approvalRequests    ApprovalRequest[]
  reminders           ReminderSchedule[]
  notifications       NotificationLog[]
  auditLogs           AuditLog[]    @relation("DepositAuditLogs")

  @@index([status])
  @@index([depositType])
  @@index([maturityDate])
  @@index([bankId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([createdAt])
}

// ─── Lifecycle & Approvals ────────────────────────────────────────────────────

model LifecycleEvent {
  id         String        @id @default(cuid()) @map("_id")
  depositId  String
  deposit    Deposit       @relation(fields: [depositId], references: [id])
  fromStatus DepositStatus?
  toStatus   DepositStatus
  actorId    String?
  notes      String?
  metadata   Json?
  occurredAt DateTime      @default(now())

  @@index([depositId])
  @@index([occurredAt])
}

model ApprovalRequest {
  id               String         @id @default(cuid()) @map("_id")
  depositId        String
  deposit          Deposit        @relation(fields: [depositId], references: [id])
  requestedBy      String?
  actorId          String?
  actor            User?          @relation("ApprovalActor", fields: [actorId], references: [id])
  action           ApprovalAction
  notes            String?
  // High-value dual approval: set when a second approver (SUPER_ADMIN) confirms
  isHighValue      Boolean        @default(false)
  secondApproverId String?
  secondApprovedAt DateTime?
  createdAt        DateTime       @default(now())

  @@index([depositId])
  @@index([actorId])
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id             String       @id @default(cuid()) @map("_id")
  depositId      String
  deposit        Deposit      @relation(fields: [depositId], references: [id])
  documentType   DocumentType @default(OTHER)
  originalName   String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String?
  uploadedById   String?
  uploadedAt     DateTime     @default(now())
  isArchived     Boolean      @default(false)
  archivedAt     DateTime?

  @@index([depositId])
  @@index([documentType])
}

// ─── Reminder & Notification ──────────────────────────────────────────────────

model ReminderSchedule {
  id             String            @id @default(cuid()) @map("_id")
  depositId      String
  deposit        Deposit           @relation(fields: [depositId], references: [id])
  event          NotificationEvent
  scheduledFor   DateTime
  processedAt    DateTime?
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())

  @@index([depositId])
  @@index([scheduledFor])
  @@index([processedAt])
}

model NotificationLog {
  id             String             @id @default(cuid()) @map("_id")
  depositId      String?
  deposit        Deposit?           @relation(fields: [depositId], references: [id])
  event          NotificationEvent
  recipientEmail String
  subject        String
  status         NotificationStatus @default(PENDING)
  providerMsgId  String?
  attemptCount   Int                @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  errorMessage   String?
  idempotencyKey String             @unique
  createdAt      DateTime           @default(now())

  @@index([depositId])
  @@index([status])
  @@index([createdAt])
}

model NotificationPreference {
  id        String            @id @default(cuid()) @map("_id")
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  event     NotificationEvent
  enabled   Boolean           @default(true)
  updatedAt DateTime          @updatedAt

  @@unique([userId, event])
}

model ReminderConfig {
  id              String   @id @default(cuid()) @map("_id")
  daysBeforeEvent Int      @unique
  isEnabled       Boolean  @default(true)
  recipientEmails String[] @default([])
  updatedAt       DateTime @updatedAt
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid()) @map("_id")
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  actorEmail String?
  action     AuditAction
  targetType String?
  targetId   String?
  deposit    Deposit?    @relation("DepositAuditLogs", fields: [targetId], references: [id])
  outcome    String      @default("SUCCESS")
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  occurredAt DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([occurredAt])
  @@index([actorEmail])
}

// ─── Payment Requests (Client-facing) ────────────────────────────────────────

model PaymentRequest {
  id            String               @id @default(cuid()) @map("_id")
  requestNumber String               @unique
  clientId      String
  client        User                 @relation("ClientRequests", fields: [clientId], references: [id])
  type          PaymentRequestType
  status        PaymentRequestStatus @default(SUBMITTED)

  amount          Float?
  currency        String               @default("INR")
  bankName        String?
  accountNumber   String?
  durationMonths  Int?
  description     String
  urgency         String               @default("NORMAL")

  reviewedById  String?
  reviewedBy    User?                @relation("ReviewedRequests", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNotes   String?

  depositId     String?

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  statusHistory PaymentRequestHistory[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model PaymentRequestHistory {
  id        String               @id @default(cuid()) @map("_id")
  requestId String
  request   PaymentRequest       @relation(fields: [requestId], references: [id])
  status    PaymentRequestStatus
  notes     String?
  actorId   String?
  createdAt DateTime             @default(now())

  @@index([requestId])
}

// ─── KYC Verification ────────────────────────────────────────────────────────

model KycVerification {
  id             String          @id @default(cuid()) @map("_id")
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType   KycDocumentType
  documentNumber String?
  fullName       String?
  status         KycStatus       @default(PENDING_REVIEW)
  submittedAt    DateTime        @default(now())
  reviewedById   String?
  reviewedBy     User?           @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNotes    String?
  updatedAt      DateTime        @updatedAt

  @@index([status])
}

// ─── Rate Limiting ────────────────────────────────────────────────────────────

model RateLimit {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  count     Int      @default(1)
  windowEnd DateTime
  updatedAt DateTime @updatedAt

  @@index([windowEnd])
}

// ─── Application Settings ─────────────────────────────────────────────────────

model AppSetting {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
