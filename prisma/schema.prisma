// Prisma schema for FD/Security Deposit Management Portal
// Database: PostgreSQL
// Generated with: prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  FINANCE_OFFICER
  AUDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

enum DepositType {
  FIXED_DEPOSIT        // Standard interest-bearing FD
  SECURITY_DEPOSIT     // Performance/bid security
  BANK_GUARANTEE       // BG issued by bank
  EARNEST_MONEY        // EMD for tenders
  LEASE_DEPOSIT        // Lease/rental security
  OTHER
}

enum DepositStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  MATURING_SOON       // Within configurable threshold (e.g. 30 days)
  MATURED
  RENEWAL_PENDING
  RENEWED
  RELEASE_PENDING
  RELEASED
  CANCELLED
  ARCHIVED
}

enum DocumentType {
  FDR_CERTIFICATE
  RECEIPT
  BANK_CORRESPONDENCE
  CONTRACT
  RENEWAL_DOCUMENT
  RELEASE_DOCUMENT
  SUPPORTING_EVIDENCE
  OTHER
}

enum NotificationEvent {
  DAYS_90
  DAYS_60
  DAYS_30
  DAYS_15
  DAYS_7
  DAYS_1
  ON_DATE
  OVERDUE
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum AuditAction {
  // Auth
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  MFA_ENABLED
  MFA_DISABLED
  SESSION_REVOKED
  // User management
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_ACTIVATED
  USER_ROLE_CHANGED
  // Deposit
  DEPOSIT_CREATED
  DEPOSIT_UPDATED
  DEPOSIT_STATUS_CHANGED
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  DEPOSIT_SUBMITTED
  DEPOSIT_RELEASED
  DEPOSIT_RENEWED
  DEPOSIT_CANCELLED
  DEPOSIT_ARCHIVED
  DEPOSIT_VIEWED
  DEPOSIT_EXPORTED
  // Documents
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  DOCUMENT_REPLACED
  DOCUMENT_DELETED
  // Notifications
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  REMINDER_CONFIG_CHANGED
  // Admin
  SETTINGS_CHANGED
  REPORT_GENERATED
  EXPORT_GENERATED
  WEBHOOK_RECEIVED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  emailVerified        DateTime?
  name                 String
  hashedPassword       String?
  role                 UserRole  @default(FINANCE_OFFICER)
  status               UserStatus @default(ACTIVE)
  department           String?
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?   // encrypted TOTP secret
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?

  // Relations
  sessions             Session[]
  accounts             Account[]
  depositsCreated      Deposit[]  @relation("DepositCreatedBy")
  depositsOwned        Deposit[]  @relation("DepositOwner")
  depositsApproved     Deposit[]  @relation("DepositApprovedBy")
  approvalActions      ApprovalRequest[] @relation("ApprovalActor")
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  notificationPrefs    NotificationPreference[]

  @@index([email])
  @@index([status])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Reference Data ───────────────────────────────────────────────────────────

model Bank {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  branches  BankBranch[]
  deposits  Deposit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model BankBranch {
  id        String   @id @default(cuid())
  bankId    String
  name      String
  ifsc      String?
  address   String?
  city      String?
  bank      Bank     @relation(fields: [bankId], references: [id])
  deposits  Deposit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bankId, name])
  @@index([bankId])
}

model Beneficiary {
  id        String   @id @default(cuid())
  name      String
  type      String?  // vendor, contractor, govt, individual, etc.
  panNumber String?  // masked in UI
  gstNumber String?
  address   String?
  contact   String?
  email     String?
  deposits  Deposit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  deposits  Deposit[]
  createdAt DateTime @default(now())

  @@index([name])
}

// ─── Core Deposit Model ───────────────────────────────────────────────────────

model Deposit {
  id                  String        @id @default(cuid())
  referenceNumber     String        @unique  // internal: FDP-2024-0001
  certificateNumber   String?       // bank-issued FDR/certificate number
  depositType         DepositType   @default(FIXED_DEPOSIT)
  status              DepositStatus @default(DRAFT)

  // Bank & account
  bankId              String?
  branchId            String?
  accountNumber       String?       // stored encrypted / masked in display
  bank                Bank?         @relation(fields: [bankId], references: [id])
  branch              BankBranch?   @relation(fields: [branchId], references: [id])

  // Parties
  beneficiaryId       String?
  beneficiary         Beneficiary?  @relation(fields: [beneficiaryId], references: [id])
  issuingOrganization String?
  vendorReference     String?       // linked contract / tender / project
  contractNumber      String?

  // Financials (DECIMAL for precision — stored as strings in Prisma for JS big number safety)
  principalAmount     Decimal       @db.Decimal(20, 2)
  currency            String        @default("INR")
  interestRate        Decimal?      @db.Decimal(8, 4)
  maturityAmount      Decimal?      @db.Decimal(20, 2)

  // Dates
  issueDate           DateTime      @db.Date
  maturityDate        DateTime?     @db.Date
  expiryDate          DateTime?     @db.Date
  renewalDate         DateTime?     @db.Date
  releaseDate         DateTime?     @db.Date

  // Ownership
  departmentId        String?
  department          Department?   @relation(fields: [departmentId], references: [id])
  ownerId             String?
  owner               User?         @relation("DepositOwner", fields: [ownerId], references: [id])

  // Approval
  approvedById        String?
  approvedAt          DateTime?
  approvedBy          User?         @relation("DepositApprovedBy", fields: [approvedById], references: [id])

  // Meta
  isRenewalEligible   Boolean       @default(true)
  renewedFromId       String?       // if this FD was renewed from another
  renewedToId         String?       // if this FD was renewed into another
  notes               String?
  tags                String[]      @default([])

  // Audit fields
  createdById         String?
  createdBy           User?         @relation("DepositCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Related
  documents           Document[]
  lifecycleEvents     LifecycleEvent[]
  approvalRequests    ApprovalRequest[]
  reminders           ReminderSchedule[]
  notifications       NotificationLog[]
  auditLogs           AuditLog[]    @relation("DepositAuditLogs")

  @@index([status])
  @@index([depositType])
  @@index([maturityDate])
  @@index([expiryDate])
  @@index([bankId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([referenceNumber])
  @@index([certificateNumber])
  @@index([createdAt])
}

// ─── Lifecycle & Approvals ────────────────────────────────────────────────────

model LifecycleEvent {
  id          String        @id @default(cuid())
  depositId   String
  deposit     Deposit       @relation(fields: [depositId], references: [id])
  fromStatus  DepositStatus?
  toStatus    DepositStatus
  actorId     String?
  notes       String?
  metadata    Json?
  occurredAt  DateTime      @default(now())

  @@index([depositId])
  @@index([occurredAt])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  depositId   String
  deposit     Deposit        @relation(fields: [depositId], references: [id])
  requestedBy String?
  actorId     String?
  actor       User?          @relation("ApprovalActor", fields: [actorId], references: [id])
  action      ApprovalAction
  notes       String?
  createdAt   DateTime       @default(now())

  @@index([depositId])
  @@index([actorId])
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id              String       @id @default(cuid())
  depositId       String
  deposit         Deposit      @relation(fields: [depositId], references: [id])
  documentType    DocumentType @default(OTHER)
  originalName    String       // sanitized display name
  storagePath     String       // opaque server-generated key
  mimeType        String
  sizeBytes       Int
  checksumSha256  String?
  uploadedById    String?
  uploadedAt      DateTime     @default(now())
  isArchived      Boolean      @default(false)
  archivedAt      DateTime?

  @@index([depositId])
  @@index([documentType])
}

// ─── Reminder & Notification ──────────────────────────────────────────────────

model ReminderSchedule {
  id            String            @id @default(cuid())
  depositId     String
  deposit       Deposit           @relation(fields: [depositId], references: [id])
  event         NotificationEvent
  scheduledFor  DateTime
  processedAt   DateTime?
  idempotencyKey String           @unique  // prevents double-processing
  createdAt     DateTime          @default(now())

  @@index([depositId])
  @@index([scheduledFor])
  @@index([processedAt])
}

model NotificationLog {
  id              String             @id @default(cuid())
  depositId       String?
  deposit         Deposit?           @relation(fields: [depositId], references: [id])
  event           NotificationEvent
  recipientEmail  String
  subject         String
  status          NotificationStatus @default(PENDING)
  providerMsgId   String?
  attemptCount    Int                @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  errorMessage    String?
  idempotencyKey  String             @unique
  createdAt       DateTime           @default(now())

  @@index([depositId])
  @@index([status])
  @@index([createdAt])
}

model NotificationPreference {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  event     NotificationEvent
  enabled   Boolean           @default(true)
  updatedAt DateTime          @updatedAt

  @@unique([userId, event])
}

// Global reminder config (admin-configurable)
model ReminderConfig {
  id              String   @id @default(cuid())
  daysBeforeEvent Int      @unique  // e.g. 90, 60, 30, 15, 7, 1, 0
  isEnabled       Boolean  @default(true)
  recipientEmails String[] @default([])  // global CC list
  updatedAt       DateTime @updatedAt
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String      @id @default(cuid())
  actorId      String?
  actor        User?       @relation(fields: [actorId], references: [id])
  actorEmail   String?     // denormalized for retention after user deletion
  action       AuditAction
  targetType   String?     // "Deposit", "User", "Document", etc.
  targetId     String?
  deposit      Deposit?    @relation("DepositAuditLogs", fields: [targetId], references: [id])
  outcome      String      @default("SUCCESS")  // SUCCESS | FAILURE
  ipAddress    String?
  userAgent    String?
  metadata     Json?       // non-sensitive extra context
  occurredAt   DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([occurredAt])
  @@index([actorEmail])
}

// ─── Rate Limiting ────────────────────────────────────────────────────────────

model RateLimit {
  id         String   @id @default(cuid())
  key        String   @unique  // IP:action or userId:action
  count      Int      @default(1)
  windowEnd  DateTime
  updatedAt  DateTime @updatedAt

  @@index([key])
  @@index([windowEnd])
}

// ─── Application Settings ─────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
